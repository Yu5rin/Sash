<?xml version="1.0" encoding="utf-8"?>
<!--
  self-contained の単一 exe として発行する。
  使い方: dotnet publish src/Sash.App -p:PublishProfile=win-x64
  リリースのワークフロー（.github/workflows/release.yml）と tools/New-Release.ps1 が、
  この名前のプロファイルと出力先（artifacts/publish/win-x64/Sash.exe）に頼っている。名前と出力先を変えないこと。
-->
<Project>
  <PropertyGroup>
    <!-- 配布物は必ず Release。引数の付け忘れで Debug が配られないよう、プロファイル側で固定する -->
    <Configuration>Release</Configuration>
    <!-- 利用者の PC に .NET が無くても動くよう、Windows x64 向けのランタイムごと固める -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- 配るのは exe 1つだけにする（更新処理が入れ替える対象も exe 1つ） -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WebView2Loader.dll などのネイティブ dll も exe の中に入れる。入れないと発行先に dll が散らばる -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Linux のランナーでは win-x64 向けの ReadyToRun コンパイルが安定しないので使わない -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- パッケージ付属の xml ドキュメントを発行先にコピーしない -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- プロジェクトのフォルダ（src/Sash.App）からリポジトリ直下の artifacts/ へ。スラッシュ区切りは Linux でも Windows でも通る -->
    <PublishDir>$(MSBuildProjectDirectory)/../../artifacts/publish/win-x64/</PublishDir>
  </PropertyGroup>
</Project>
